{
  "name": "@doc-cheap/mcp",
  "version": "0.1.0",
  "description": "MCP server for passport, ID and MRZ recognition via the doc.cheap API — $0.01 per document",
  "license": "MIT",
  "homepage": "https://doc.cheap/docs/guides/use-the-mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/cheap-doc/ocr-mcp"
  },
  "bugs": {
    "url": "https://github.com/cheap-doc/ocr-mcp/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "mcp-server",
    "ocr",
    "passport",
    "id-document",
    "mrz",
    "identity-verification",
    "kyc",
    "document-recognition"
  ],
  "mcpName": "cheap.doc/mcp",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "doc-cheap-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@sentry/node": "10.73.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
